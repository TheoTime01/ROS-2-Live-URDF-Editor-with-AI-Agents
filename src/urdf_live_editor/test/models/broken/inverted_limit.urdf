<?xml version="1.0"?>
<!-- Broken: prismatic joint lower limit exceeds its upper limit. -->
<robot name="inverted_limit">
  <link name="base_link"/>
  <link name="slider"/>
  <joint name="lift" type="prismatic">
    <parent link="base_link"/>
    <child link="slider"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.5" upper="-0.5" effort="50.0" velocity="0.5"/>
  </joint>
</robot>
