<?xml version="1.0"?>
<!-- Known-good model exercising fixed and prismatic joint rules. -->
<robot name="fixed_and_prismatic">
  <link name="base_link"/>
  <link name="mount"/>
  <link name="slider"/>

  <joint name="mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mount"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <joint name="lift" type="prismatic">
    <parent link="mount"/>
    <child link="slider"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="0.2" effort="50.0" velocity="0.5"/>
  </joint>
</robot>
