<?xml version="1.0"?>
<!-- Sample 3-DOF arm used by demos and tests. This is a plain, already-expanded
     URDF (no Xacro) so it can be parsed by tests without a Xacro toolchain. -->
<robot name="sample_arm">
  <link name="base_link"/>
  <link name="link_1"/>
  <link name="link_2"/>
  <link name="link_3"/>
  <link name="tool_link"/>

  <joint name="shoulder" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="20.0" velocity="1.5"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <joint name="elbow" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="15.0" velocity="1.5"/>
    <origin xyz="0 0 0.4" rpy="0 0 0"/>
  </joint>

  <joint name="wrist" type="continuous">
    <parent link="link_2"/>
    <child link="link_3"/>
    <axis xyz="1 0 0"/>
    <origin xyz="0 0 0.4" rpy="0 0 0"/>
  </joint>

  <joint name="tool_mount" type="fixed">
    <parent link="link_3"/>
    <child link="tool_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>
</robot>
