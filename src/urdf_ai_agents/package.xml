<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>urdf_ai_agents</name>
  <version>0.5.0</version>
  <description>
    Claude Agent SDK layer for the ROS 2 Live URDF Editor. Agents route every
    change through the deterministic staged-validation pipeline in
    urdf_live_editor. Milestone 5 contributes the Launch/Integration Agent.
  </description>
  <maintainer email="titanblack733@gmail.com">Project maintainers</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>urdf_live_editor</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
